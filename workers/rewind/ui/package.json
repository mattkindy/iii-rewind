{
  "name": "rewind-ui",
  "private": true,
  "type": "module",
  "description": "Rewind's page in the iii console: triage recorded runs, fork one with a changed answer, compare, recover.",
  "scripts": {
    "build": "npm run typecheck && tsx build.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test --import tsx test/*.test.ts",
    "mock": "tsx dev/mockWorker.ts",
    "shoot": "tsx dev/shoot.ts"
  },
  "devDependencies": {
    "@iii-dev/console-ui": "0.4.0",
    "@types/node": "20.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.25.12",
    "iii-sdk": "0.26.0",
    "lucide-react": "1.16.0",
    "playwright-core": "1.55.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
